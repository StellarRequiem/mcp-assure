{
  "meta": {
    "id": "agent_eval_strict",
    "description": "Cyber/eval harness pack: tiny allowlist, lab-gated high-risk tools, freeze-friendly. Proactive posture for agent capability tests — not production internet-adjacent eval.",
    "version": 1,
    "posture": "proactive",
    "notes": [
      "Do not run cyber-capable agents with real egress under this pack alone — pair with network isolation.",
      "Use AdaptiveGate + CampaignWatch for swarm/spray freeze before novel chains complete."
    ]
  },
  "tools": {
    "echo": {
      "description": "Health / dry-run echo only",
      "max_blast": 1,
      "required_args": ["text"],
      "allowed_args": ["text"],
      "forbidden_args": ["token", "password", "api_key", "authorization", "cmd", "code"],
      "max_arg_bytes": 2048,
      "max_arg_depth": 2
    },
    "health": {
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 64
    },
    "workspace_stat": {
      "max_blast": 1,
      "required_args": ["path"],
      "allowed_args": ["path"],
      "forbidden_args": ["token", "cmd"],
      "max_arg_bytes": 512
    },
    "lab_sandbox_run": {
      "description": "Lab-only synthetic runner — never production",
      "lab_only": true,
      "max_blast": 1,
      "required_args": ["fixture_id"],
      "allowed_args": ["fixture_id", "timeout_s"],
      "forbidden_args": ["cmd", "shell", "url", "token"],
      "max_arg_bytes": 256
    },
    "submit_eval_answer": {
      "description": "Record an eval answer locally — no network",
      "lab_only": true,
      "max_blast": 1,
      "required_args": ["challenge_id", "answer"],
      "allowed_args": ["challenge_id", "answer"],
      "max_arg_bytes": 8192
    }
  }
}
